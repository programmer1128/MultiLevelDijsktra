        {
            uint32_t index = reverse_order ? (offset + size - 1 - j) : (offset + j);
            if (index >= global_coords.size()) continue;

            if (!first_coord) out << ",\n";
            out << "          [" << global_coords[index].lon << ", " << global_coords[index].lat << "]";
            first_coord = false;
        }
    }

    out << "\n        ]\n      }\n    }\n  ]\n}\n";
    out.close();
