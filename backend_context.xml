         return 1;
     }
     visited[node]=true;
     for(Node* neigh:network[node])
     {
         //std::cout<<"node = "<<node->id<<" neigh = "<<neigh->id<<" capa = "<<capacity[node][neigh]<<"\n";
         if(!visited[neigh]&&capacity[node][neigh]>0)
         {
             //std::cout<<"hello\n";
             int maxPush=findMaxFlow(network,capacity,visited,neigh,1);

